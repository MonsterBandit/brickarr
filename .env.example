# Brickarr environment — example values for local/dev/compose use.
#
# DB / Redis connection only. Data-source credentials (BrickLink, Brickset) are
# entered in-app at Settings -> Data Sources at runtime and are NEVER configured
# here. See compose.example.yaml for a reference stack.

# MariaDB
BRICKARR_DB_HOST=mariadb
BRICKARR_DB_PORT=3306
BRICKARR_DB_NAME=brickarr
BRICKARR_DB_USER=brickarr
BRICKARR_DB_PASSWORD=

# Redis (cache, job queue, daily BrickLink budget counter)
BRICKARR_REDIS_URL=redis://redis:6379/0

# *arr-style user/group/timezone for the container process.
PUID=1000
PGID=1000
TZ=Etc/UTC
