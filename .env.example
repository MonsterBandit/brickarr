# Brickarr — example .env for compose.example.yaml and compose.mariadb.example.yaml.
#
# Names only: copy to .env and fill in your own values. Secrets stay blank
# here. A blank line keeps the compose file's default, shown in brackets.
# Data-source keys (Brickset, and Rebrickable once it arrives) are entered in
# the app at Settings -> Data Sources, never here.

# *arr-style user [1000], group [1000], timezone [Etc/UTC] and file mask [022].
PUID=
PGID=
TZ=
UMASK=

# MariaDB only (compose.mariadb.example.yaml); the simple install uses SQLite.
# Database [brickarr], user [brickarr]; the password has no default.
BRICKARR_DB_NAME=
BRICKARR_DB_USER=
BRICKARR_DB_PASSWORD=
